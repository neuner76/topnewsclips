# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# Supabase — found at: supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://topnewsclips.com

# My Local — air quality (both optional). AirNow is preferred (official EPA
# monitors); PurpleAir (community sensors) is the fallback when AirNow has no
# reading near the point. PurpleAir needs a READ key (sent as X-API-Key).
# AirNow: https://docs.airnowapi.org/  |  PurpleAir: https://develop.purpleair.com/
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
